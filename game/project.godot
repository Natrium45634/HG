; Engine configuration file.
config_version=5

[application]

config/name="HexTactics"
config/description="Тактическая игра на гексагональной карте"
config/version="1.0.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.4", "C#", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.12, 0.13, 0.15, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="disabled"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="HexTactics"

[gui]

common/snap_controls_to_pixels=true

[physics]

common/physics_ticks_per_second=30

[rendering]

anti_aliasing/quality/msaa_3d=2
rendering_device/fallback_to_opengl3=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.12, 0.13, 0.15, 1)
