{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hextactics/terrains.schema.json",
  "title": "местность (terrains.json)",
  "type": "object",
  "required": [
    "formatVersion",
    "items"
  ],
  "properties": {
    "formatVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Версия формата; старые версии мигрируются при загрузке"
    },
    "kind": {
      "const": "terrains"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TerrainDef"
      }
    }
  },
  "$defs": {
    "PitRulesDef": {
      "type": "object",
      "properties": {
        "affectedLayers": {
          "type": "array",
          "items": {
            "type": "string",
            "x-ref": "Layer"
          },
          "description": "Действует на слои — Пусто — только наземный"
        },
        "animation": {
          "type": "string",
          "enum": [
            "Drop",
            "Fade",
            "Shrink",
            "None"
          ],
          "description": "Анимация падения"
        },
        "animationSeconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Длительность анимации, с"
        },
        "consequence": {
          "type": "string",
          "enum": [
            "Death",
            "DamageAndReturn",
            "Remove"
          ],
          "description": "Последствие падения"
        },
        "damageType": {
          "type": "string",
          "x-ref": "DamageType",
          "description": "Тип урона падения"
        },
        "enterable": {
          "type": "boolean",
          "description": "Можно войти — Существо может оказаться в клетке (и упасть); иначе клетка просто непроходима"
        },
        "fallDamage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000,
          "description": "Урон при падении — Для «урон и возврат»"
        },
        "immune": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Иммунные категории/теги — Категории существ или tag:тег юнита"
        },
        "rescueStatuses": {
          "type": "array",
          "items": {
            "type": "string",
            "x-ref": "Status"
          },
          "description": "Спасающие состояния — Пока наложено — не падает (парение, крюк…)"
        }
      },
      "additionalProperties": true
    },
    "TerrainDef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID — Уникальный идентификатор (латиница, цифры, _)"
        },
        "name": {
          "type": "string",
          "description": "Название"
        },
        "description": {
          "type": "string",
          "description": "Описание"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Теги — Теги для правил, навыков и синергий"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Синонимы для поиска — Другие названия, по которым объект находится в поиске и в быстром вводе (например «святой, holy» у «Света»)"
        },
        "group": {
          "type": "string",
          "description": "Категория в библиотеке — Группа для поиска и фильтров библиотеки (например «Боссы»)"
        },
        "version": {
          "type": "integer",
          "description": "Версия — Увеличивается автоматически при публикации изменений"
        },
        "incomplete": {
          "type": "boolean",
          "description": "Неполный (черновик) — Объект сохранён или импортирован без всех зависимостей: он виден в библиотеке, но сценарии с ним не запускаются"
        },
        "allowsPlacement": {
          "type": "boolean",
          "description": "Можно размещать юнитов"
        },
        "blocksLoS": {
          "type": "boolean",
          "description": "Блокирует обзор"
        },
        "category": {
          "type": "string",
          "enum": [
            "Terrain",
            "Stat",
            "Resource",
            "DamageType",
            "Faction",
            "Unit",
            "Skill",
            "Passive",
            "CellEffect",
            "Synergy",
            "Status",
            "AiProfile",
            "Map",
            "Scenario",
            "MoveCategory",
            "MapTemplate",
            "Layer",
            "Element",
            "RulesPreset",
            "Asset",
            "Vfx",
            "Formation",
            "Origin",
            "GroupPreset",
            "ScalingProfile",
            "GameRules",
            "SquadPreset",
            "ZonePreset",
            "ModifierSet",
            "DifficultyVariant"
          ]
        },
        "color": {
          "type": "string",
          "pattern": "^(#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?)?$",
          "description": "Цвет"
        },
        "cover": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Укрытие — 0..1, штраф к точности дистанционных атак по юниту в клетке"
        },
        "defaultHeight": {
          "type": "integer",
          "minimum": -5,
          "maximum": 10,
          "description": "Высота по умолчанию — Высота при рисовании кистью (возвышенность +1, низина -1)"
        },
        "destroyedTerrain": {
          "type": "string",
          "x-ref": "Terrain",
          "description": "Становится после разрушения"
        },
        "destructibleHp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000,
          "description": "Прочность препятствия — 0 = неразрушимо"
        },
        "displayName": {
          "type": "string"
        },
        "hazard": {
          "type": "boolean",
          "description": "Опасная — ИИ и маршрутизатор избегают клетку, интерфейс предупреждает"
        },
        "intrinsicEffects": {
          "type": "array",
          "items": {
            "type": "string",
            "x-ref": "CellEffect"
          },
          "description": "Постоянные эффекты — Эффекты клеток, всегда действующие на этой местности"
        },
        "isObstacle": {
          "type": "boolean"
        },
        "kind": {
          "type": "string",
          "enum": [
            "Floor",
            "Elevation",
            "Obstacle",
            "Liquid",
            "Pit",
            "Hazard",
            "Special"
          ],
          "description": "Вид местности — Пол, препятствие, жидкость, яма… — для библиотеки, шаблонов и кистей"
        },
        "look": {
          "$ref": "#/$defs/TerrainLookDef",
          "description": "Внешний вид — Материал, высота, фаска, прозрачность, свечение, тень, контур, узор, символ"
        },
        "moveCost": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 100,
          "description": "Стоимость перемещения — Стоимость входа в клетку (до учёта высоты и эффектов)"
        },
        "moveCostByCategory": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "x-key-ref": "MoveCategory",
          "description": "Стоимость по категориям — Переопределение стоимости для категории движения"
        },
        "obstacleHeight": {
          "type": "number",
          "minimum": 0,
          "maximum": 20,
          "description": "Высота препятствия — В уровнях высоты, над поверхностью клетки (для линии видимости)"
        },
        "passableFor": {
          "type": "array",
          "items": {
            "type": "string",
            "x-ref": "MoveCategory"
          },
          "description": "Проходима для — Категории движения, которые могут войти в клетку"
        },
        "passives": {
          "type": "array",
          "items": {
            "type": "string",
            "x-ref": "Passive"
          },
          "description": "Пассивы стоящих — Действуют, пока юнит стоит на гексе (источник «тип гекса»)"
        },
        "pit": {
          "$ref": "#/$defs/PitRulesDef",
          "description": "Яма — Поведение при падении"
        },
        "visual": {
          "type": "string",
          "enum": [
            "Ground",
            "Grass",
            "Sand",
            "Stone",
            "Water",
            "Pit",
            "Wall",
            "Rock",
            "Crate",
            "Vegetation",
            "Hazard",
            "Special",
            "Ice",
            "Rubble",
            "TechFloor",
            "Platform",
            "Lava",
            "Acid",
            "Barrier",
            "Trap",
            "Chasm",
            "Pillars",
            "Railing",
            "Terminal"
          ],
          "description": "Стиль отрисовки — Форма и декор (камни, контейнеры, колонны…)"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": true
    },
    "TerrainLookDef": {
      "type": "object",
      "properties": {
        "accentColor": {
          "type": "string",
          "pattern": "^(#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?)?$",
          "description": "Акцентный цвет — Кромка, свечение, узор"
        },
        "animation": {
          "type": "string",
          "enum": [
            "None",
            "Flow",
            "Pulse",
            "Shimmer"
          ],
          "description": "Анимация"
        },
        "bevel": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.3,
          "description": "Фаска — Доля радиуса гекса"
        },
        "castShadow": {
          "type": "boolean",
          "description": "Отбрасывает тень"
        },
        "depth": {
          "type": "number",
          "minimum": 0,
          "maximum": 30,
          "description": "Глубина — Ямы и жидкости: глубина в уровнях высоты"
        },
        "extraHeight": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Доп. высота плиты — Уровней высоты над поверхностью (стены, платформы)"
        },
        "glow": {
          "type": "number",
          "minimum": 0,
          "maximum": 8,
          "description": "Свечение — Сила свечения акцентным цветом (0 — нет)"
        },
        "material": {
          "type": "string",
          "enum": [
            "Matte",
            "Metal",
            "Glossy",
            "Glass",
            "Liquid",
            "Emissive",
            "Hologram"
          ],
          "description": "Материал"
        },
        "outlineColor": {
          "type": "string",
          "pattern": "^(#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?)?$",
          "description": "Цвет контура — Обводка верхней грани; пусто — нет"
        },
        "outlineWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.2,
          "description": "Толщина контура"
        },
        "pattern": {
          "type": "string",
          "enum": [
            "None",
            "Stripes",
            "Grid",
            "Chevrons",
            "Dots",
            "Cross",
            "Hazard",
            "Ring"
          ],
          "description": "Узор — Дополнительный признак помимо цвета"
        },
        "persistentVfx": {
          "type": "string",
          "x-ref": "Vfx",
          "description": "Постоянный эффект — Визуальный эффект на каждой клетке этой местности (циклический)"
        },
        "propModel": {
          "type": "string",
          "x-ref": "Asset",
          "description": "Модель объекта на клетке — Например, ящик или колонна; при ошибке файла — базовая геометрия"
        },
        "sideColor": {
          "type": "string",
          "pattern": "^(#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?)?$",
          "description": "Цвет боковых граней — Пусто — темнее верха"
        },
        "sideMaterial": {
          "type": "string",
          "x-ref": "Asset",
          "description": "Материал боковых граней — Ресурс «Материал»; пусто — цвет граней"
        },
        "simpleWithoutTextures": {
          "type": "boolean",
          "description": "Упрощённо: без текстур — При «упрощённых эффектах» — только цвета"
        },
        "symbol": {
          "type": "string",
          "description": "Символ — 1–2 знака поверх клетки (⚠, ☣, ✕…)"
        },
        "topMaterial": {
          "type": "string",
          "x-ref": "Asset",
          "description": "Материал верхней грани — Ресурс «Материал»; пусто — по настройкам выше"
        },
        "topTexture": {
          "type": "string",
          "x-ref": "Asset",
          "description": "Текстура верхней стороны — Ресурс «Текстура» (назначение «поверхность гекса»)"
        },
        "transparency": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.95,
          "description": "Прозрачность"
        },
        "variants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TerrainVariantDef"
          },
          "description": "Варианты вида — Выбор по координатам клетки — одинаково при каждом запуске, правила не меняются"
        }
      },
      "additionalProperties": true
    },
    "TerrainVariantDef": {
      "type": "object",
      "properties": {
        "tint": {
          "type": "string",
          "pattern": "^(#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?)?$",
          "description": "Оттенок — Пусто — без изменения"
        },
        "topMaterial": {
          "type": "string",
          "x-ref": "Asset",
          "description": "Материал верха"
        },
        "topTexture": {
          "type": "string",
          "x-ref": "Asset",
          "description": "Текстура верха"
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Вес — Чаще выбирается вариант с большим весом"
        }
      },
      "additionalProperties": true
    }
  }
}
