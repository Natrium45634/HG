{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hextactics/resources.schema.json",
  "title": "ресурс (resources.json)",
  "type": "object",
  "required": [
    "formatVersion",
    "items"
  ],
  "properties": {
    "formatVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Версия формата; старые версии мигрируются при загрузке"
    },
    "kind": {
      "const": "resources"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ResourceDef"
      }
    }
  },
  "$defs": {
    "ResourceDef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID — Уникальный идентификатор (латиница, цифры, _)"
        },
        "name": {
          "type": "string",
          "description": "Название"
        },
        "description": {
          "type": "string",
          "description": "Описание"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Теги — Теги для правил, навыков и синергий"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Синонимы для поиска — Другие названия, по которым объект находится в поиске и в быстром вводе (например «святой, holy» у «Света»)"
        },
        "group": {
          "type": "string",
          "description": "Категория в библиотеке — Группа для поиска и фильтров библиотеки (например «Боссы»)"
        },
        "version": {
          "type": "integer",
          "description": "Версия — Увеличивается автоматически при публикации изменений"
        },
        "incomplete": {
          "type": "boolean",
          "description": "Неполный (черновик) — Объект сохранён или импортирован без всех зависимостей: он виден в библиотеке, но сценарии с ним не запускаются"
        },
        "category": {
          "type": "string",
          "enum": [
            "Terrain",
            "Stat",
            "Resource",
            "DamageType",
            "Faction",
            "Unit",
            "Skill",
            "Passive",
            "CellEffect",
            "Synergy",
            "Status",
            "AiProfile",
            "Map",
            "Scenario",
            "MoveCategory",
            "MapTemplate",
            "Layer",
            "Element",
            "RulesPreset",
            "Asset",
            "Vfx",
            "Formation",
            "Origin",
            "GroupPreset",
            "ScalingProfile",
            "GameRules",
            "SquadPreset"
          ]
        },
        "color": {
          "type": "string",
          "pattern": "^(#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?)?$",
          "description": "Цвет"
        },
        "defaultMax": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000,
          "description": "Максимум по умолчанию"
        },
        "defaultRegen": {
          "type": "number",
          "minimum": -1000,
          "maximum": 1000,
          "description": "Восстановление/с по умолчанию"
        },
        "displayName": {
          "type": "string"
        },
        "minValue": {
          "type": "number",
          "minimum": -100000,
          "maximum": 0,
          "description": "Минимум — 0 — обычный ресурс; отрицательный — разрешён долг (серия навыка «в долг»), шкала показывает «−»"
        },
        "showBar": {
          "type": "boolean",
          "description": "Показывать шкалу"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": true
    }
  }
}
