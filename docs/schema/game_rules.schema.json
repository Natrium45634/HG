{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hextactics/game_rules.schema.json",
  "title": "правила режима (game_rules.json)",
  "type": "object",
  "required": [
    "formatVersion",
    "items"
  ],
  "properties": {
    "formatVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Версия формата; старые версии мигрируются при загрузке"
    },
    "kind": {
      "const": "game_rules"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GameRulesDef"
      }
    }
  },
  "$defs": {
    "GameRulesDef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID — Уникальный идентификатор (латиница, цифры, _)"
        },
        "name": {
          "type": "string",
          "description": "Название"
        },
        "description": {
          "type": "string",
          "description": "Описание"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Теги — Теги для правил, навыков и синергий"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Синонимы для поиска — Другие названия, по которым объект находится в поиске и в быстром вводе (например «святой, holy» у «Света»)"
        },
        "group": {
          "type": "string",
          "description": "Категория в библиотеке — Группа для поиска и фильтров библиотеки (например «Боссы»)"
        },
        "version": {
          "type": "integer",
          "description": "Версия — Увеличивается автоматически при публикации изменений"
        },
        "incomplete": {
          "type": "boolean",
          "description": "Неполный (черновик) — Объект сохранён или импортирован без всех зависимостей: он виден в библиотеке, но сценарии с ним не запускаются"
        },
        "blocking": {
          "type": "boolean",
          "description": "Блокирование — Удержание врагов бойцами с лимитом блокирования (часть 2); выключено — никто никого не держит"
        },
        "category": {
          "type": "string",
          "enum": [
            "Terrain",
            "Stat",
            "Resource",
            "DamageType",
            "Faction",
            "Unit",
            "Skill",
            "Passive",
            "CellEffect",
            "Synergy",
            "Status",
            "AiProfile",
            "Map",
            "Scenario",
            "MoveCategory",
            "MapTemplate",
            "Layer",
            "Element",
            "RulesPreset",
            "Asset",
            "Vfx",
            "Formation",
            "Origin",
            "GroupPreset",
            "ScalingProfile",
            "GameRules",
            "SquadPreset"
          ]
        },
        "displayName": {
          "type": "string"
        },
        "friendlyFire": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Урон по союзникам в области — Не задано — из правил боя («Урон по союзникам»)"
        },
        "rulesPreset": {
          "type": "string",
          "x-ref": "RulesPreset",
          "description": "Пресет правил боя — Числа боя: ОД, урон, обзор…; пусто — глобальные правила. Пресет, выбранный в самом сценарии, сильнее"
        },
        "squadStart": {
          "type": "string",
          "enum": [
            "AllOnField",
            "StartDeployed",
            "NoneOnField"
          ],
          "description": "Отряд на поле в начале — Для сценариев с отрядом игрока: кто из выбранных бойцов стоит на поле сразу"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": true
    }
  }
}
