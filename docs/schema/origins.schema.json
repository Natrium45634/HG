{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hextactics/origins.schema.json",
  "title": "происхождение (origins.json)",
  "type": "object",
  "required": [
    "formatVersion",
    "items"
  ],
  "properties": {
    "formatVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Версия формата; старые версии мигрируются при загрузке"
    },
    "kind": {
      "const": "origins"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/OriginDef"
      }
    }
  },
  "$defs": {
    "CategoryRuleDef": {
      "type": "object",
      "properties": {
        "actionKey": {
          "type": "string"
        },
        "aiProfile": {
          "type": "string",
          "x-ref": "AiProfile",
          "description": "Профиль ИИ"
        },
        "condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/UnitConditionDef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Условие — Для «условно изменить»: пока выполнено — действует это правило"
        },
        "id": {
          "type": "string",
          "description": "ID правила — Одинаковый ID у потомка — то же правило (переопределить, исключить, условно изменить)"
        },
        "kind": {
          "type": "string",
          "enum": [
            "Passive",
            "Tag",
            "MoveCategory",
            "Forbid",
            "Allow",
            "AiProfile",
            "PowerBonus"
          ],
          "description": "Что задаёт"
        },
        "mode": {
          "type": "string",
          "enum": [
            "Inherit",
            "Add",
            "Override",
            "Exclude",
            "Conditional"
          ],
          "description": "Режим наследования"
        },
        "moveCategory": {
          "type": "string",
          "description": "Тип перемещения — walk, fly, swim, burrow, jump…"
        },
        "passive": {
          "type": "string",
          "x-ref": "Passive",
          "description": "Пассив"
        },
        "power": {
          "type": "number",
          "minimum": -100,
          "maximum": 1000,
          "description": "Вклад в силу — Ручная поправка оценки силы (этап 6), в процентах"
        },
        "priority": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100,
          "description": "Приоритет — Между разными доп. категориями: больше — сильнее"
        },
        "skillTag": {
          "type": "string",
          "description": "Тег навыков"
        },
        "tag": {
          "type": "string",
          "description": "Тег"
        },
        "what": {
          "type": "string",
          "enum": [
            "BasicAttack",
            "SkillsWithTag",
            "AllSkills",
            "Movement",
            "InitiateAttack"
          ],
          "description": "Действие"
        }
      },
      "additionalProperties": true
    },
    "ConditionDef": {
      "type": "object",
      "properties": {
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Категории врагов — Для подсчёта убитых: категории существ или tag:тег; пусто — все"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConditionDef"
          },
          "description": "Вложенные условия"
        },
        "compare": {
          "type": "string",
          "enum": [
            "AtLeast",
            "AtMost"
          ],
          "description": "Сравнение"
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000,
          "description": "Количество — Убитые/волны/прорывы; дальность для «в дальности»; номер фазы босса; число разрушений и комбинаций"
        },
        "flag": {
          "type": "string",
          "description": "Флаг"
        },
        "fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Доля здоровья"
        },
        "marker": {
          "type": "string",
          "description": "Метка карты — Для разрушения и комбинаций — пусто: где угодно"
        },
        "objective": {
          "type": "string",
          "description": "Цель (ID)"
        },
        "resource": {
          "type": "string",
          "x-ref": "Resource",
          "description": "Ресурс"
        },
        "seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 36000,
          "description": "Время, с"
        },
        "side": {
          "type": "string",
          "enum": [
            "Player",
            "Enemy",
            "Any"
          ],
          "description": "Сторона"
        },
        "status": {
          "type": "string",
          "x-ref": "Status",
          "description": "Состояние"
        },
        "synergy": {
          "type": "string",
          "x-ref": "Synergy",
          "description": "Синергия"
        },
        "type": {
          "type": "string",
          "enum": [
            "AllEnemiesDead",
            "AllPlayerUnitsDead",
            "SurviveTime",
            "ReachMarker",
            "UnitDead",
            "UnitAlive",
            "KillCount",
            "TimeElapsed",
            "WaveSpawned",
            "All",
            "Any",
            "Not",
            "InOrder",
            "UnitInArea",
            "WaveCleared",
            "WavesCleared",
            "ObjectiveCompleted",
            "ObjectiveFailed",
            "FlagSet",
            "HpBelow",
            "EnemiesLeaked",
            "Always",
            "TargetInRange",
            "EnemySpotted",
            "UnitLeftArea",
            "ResourceReached",
            "HasStatus",
            "FlagTimer",
            "ObstacleDestroyed",
            "BossPhase",
            "SynergyOccurred",
            "Environment"
          ],
          "description": "Условие"
        },
        "unitTag": {
          "type": "string",
          "description": "Метка юнита — Пусто — сам владелец (босс, носитель состояния, юнит с пассивкой или правилом ИИ)"
        },
        "value": {
          "type": "number",
          "description": "Значение — Ресурс; для состояния — минимум очков/стаков (0 — любое)"
        },
        "variable": {
          "type": "string",
          "description": "Переменная"
        },
        "variableValue": {
          "type": "string",
          "description": "Значение — Равно ли значение переменной этому"
        },
        "wave": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "description": "Волна (индекс)"
        }
      },
      "additionalProperties": true
    },
    "OriginDef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID — Уникальный идентификатор (латиница, цифры, _)"
        },
        "name": {
          "type": "string",
          "description": "Название"
        },
        "description": {
          "type": "string",
          "description": "Описание"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Теги — Теги для правил, навыков и синергий"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Синонимы для поиска — Другие названия, по которым объект находится в поиске и в быстром вводе (например «святой, holy» у «Света»)"
        },
        "group": {
          "type": "string",
          "description": "Категория в библиотеке — Группа для поиска и фильтров библиотеки (например «Боссы»)"
        },
        "version": {
          "type": "integer",
          "description": "Версия — Увеличивается автоматически при публикации изменений"
        },
        "incomplete": {
          "type": "boolean",
          "description": "Неполный (черновик) — Объект сохранён или импортирован без всех зависимостей: он виден в библиотеке, но сценарии с ним не запускаются"
        },
        "autoTags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Назначать по тегам — Юнит с любым из этих тегов получает происхождение автоматически"
        },
        "category": {
          "type": "string",
          "enum": [
            "Terrain",
            "Stat",
            "Resource",
            "DamageType",
            "Faction",
            "Unit",
            "Skill",
            "Passive",
            "CellEffect",
            "Synergy",
            "Status",
            "AiProfile",
            "Map",
            "Scenario",
            "MoveCategory",
            "MapTemplate",
            "Layer",
            "Element",
            "RulesPreset",
            "Asset",
            "Vfx",
            "Formation",
            "Origin",
            "GroupPreset",
            "ScalingProfile"
          ]
        },
        "color": {
          "type": "string",
          "pattern": "^(#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?)?$",
          "description": "Цвет"
        },
        "displayName": {
          "type": "string"
        },
        "extraParents": {
          "type": "array",
          "items": {
            "type": "string",
            "x-ref": "Origin"
          },
          "description": "Другие родители — Категория может наследовать нескольким (граф без циклов, ТЗ ч. 5, 13.2): правила всех родителей; при совпадении ID сильнее более поздний родитель и сама категория. Цикл не сохраняется"
        },
        "icon": {
          "type": "string",
          "description": "Значок — 1–2 символа"
        },
        "kind": {
          "type": "string",
          "enum": [
            "Race",
            "Species",
            "Class",
            "Role",
            "Custom"
          ],
          "description": "Вид"
        },
        "parent": {
          "type": "string",
          "x-ref": "Origin",
          "description": "Родительская категория — Дерево любой глубины: правила родителя наследуются"
        },
        "parentIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "passives": {
          "type": "array",
          "items": {
            "type": "string",
            "x-ref": "Passive"
          },
          "description": "Пассивы и таланты"
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CategoryRuleDef"
          },
          "description": "Правила — Пассивы, теги, перемещение, запреты, профиль ИИ — с режимом наследования"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": true
    },
    "UnitConditionDef": {
      "type": "object",
      "properties": {
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Категории и теги — ID категории (с предками), «tag:тег», категория существа или ID шаблона"
        },
        "centre": {
          "type": "string",
          "enum": [
            "Anchor",
            "Self",
            "Target"
          ],
          "description": "Центр области"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UnitConditionDef"
          },
          "description": "Вложенные условия"
        },
        "compare": {
          "type": "string",
          "enum": [
            "AtLeast",
            "AtMost"
          ],
          "description": "Сравнение"
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "description": "Количество"
        },
        "isLogic": {
          "type": "boolean"
        },
        "layer": {
          "type": "string",
          "description": "Слой — ID слоя (ground, air, underground…)"
        },
        "radius": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50,
          "description": "Радиус — Для «расстояние до цели» — гексов"
        },
        "resource": {
          "type": "string",
          "x-ref": "Resource",
          "description": "Ресурс — Пусто — очки действия"
        },
        "scenarioCondition": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConditionDef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Условие сценария — Без метки — для самого владельца"
        },
        "seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 3600,
          "description": "В течение, с"
        },
        "side": {
          "type": "string",
          "enum": [
            "Enemies",
            "Allies",
            "Any"
          ],
          "description": "Кто"
        },
        "skill": {
          "type": "string",
          "x-ref": "Skill",
          "description": "Навык"
        },
        "status": {
          "type": "string",
          "x-ref": "Status",
          "description": "Состояние"
        },
        "subject": {
          "type": "string",
          "enum": [
            "Self",
            "Target"
          ],
          "description": "О ком"
        },
        "terrains": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Поверхности — ID местности или эффекта клетки; «kind:Water» — вид местности"
        },
        "type": {
          "type": "string",
          "enum": [
            "Always",
            "All",
            "Any",
            "Not",
            "TargetAlive",
            "PreviousHit",
            "PreviousEffect",
            "HasStatus",
            "HpFraction",
            "Resource",
            "OnTerrain",
            "UnitType",
            "UnitsInArea",
            "AfterSkill",
            "BossPhase",
            "Scenario",
            "Category",
            "Layer",
            "Distance",
            "Environment"
          ],
          "description": "Условие"
        },
        "types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Типы — Категория существа, ID юнита, «tag:тег» или «role:роль»"
        },
        "value": {
          "type": "number",
          "description": "Значение — Доля здоровья 0..1; ресурс; для состояния — минимум очков/стаков (0 — любое); фаза босса — номер с 1"
        },
        "variable": {
          "type": "string",
          "description": "Переменная"
        },
        "variableValue": {
          "type": "string",
          "description": "Значение переменной"
        }
      },
      "additionalProperties": true
    }
  }
}
