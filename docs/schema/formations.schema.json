{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hextactics/formations.schema.json",
  "title": "формация (formations.json)",
  "type": "object",
  "required": [
    "formatVersion",
    "items"
  ],
  "properties": {
    "formatVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Версия формата; старые версии мигрируются при загрузке"
    },
    "kind": {
      "const": "formations"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FormationDef"
      }
    }
  },
  "$defs": {
    "FormationDef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID — Уникальный идентификатор (латиница, цифры, _)"
        },
        "name": {
          "type": "string",
          "description": "Название"
        },
        "description": {
          "type": "string",
          "description": "Описание"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Теги — Теги для правил, навыков и синергий"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Синонимы для поиска — Другие названия, по которым объект находится в поиске и в быстром вводе (например «святой, holy» у «Света»)"
        },
        "group": {
          "type": "string",
          "description": "Категория в библиотеке — Группа для поиска и фильтров библиотеки (например «Боссы»)"
        },
        "version": {
          "type": "integer",
          "description": "Версия — Увеличивается автоматически при публикации изменений"
        },
        "incomplete": {
          "type": "boolean",
          "description": "Неполный (черновик) — Объект сохранён или импортирован без всех зависимостей: он виден в библиотеке, но сценарии с ним не запускаются"
        },
        "category": {
          "type": "string",
          "enum": [
            "Terrain",
            "Stat",
            "Resource",
            "DamageType",
            "Faction",
            "Unit",
            "Skill",
            "Passive",
            "CellEffect",
            "Synergy",
            "Status",
            "AiProfile",
            "Map",
            "Scenario",
            "MoveCategory",
            "MapTemplate",
            "Layer",
            "Element",
            "RulesPreset",
            "Asset",
            "Vfx",
            "Formation",
            "Origin",
            "GroupPreset",
            "ScalingProfile",
            "GameRules",
            "SquadPreset",
            "ZonePreset",
            "ModifierSet",
            "DifficultyVariant",
            "ObjectPreset"
          ]
        },
        "displayName": {
          "type": "string"
        },
        "faceOutward": {
          "type": "boolean",
          "description": "Взгляд наружу — Периметр: каждый юнит смотрит от центра"
        },
        "kind": {
          "type": "string",
          "enum": [
            "Slots",
            "Free",
            "Surround",
            "Perimeter"
          ],
          "description": "Вид"
        },
        "radius": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6,
          "description": "Радиус — Окружение и периметр: расстояние от цели/точки"
        },
        "rotateWithDirection": {
          "type": "boolean",
          "description": "Поворачивать по движению — Слоты поворачиваются в сторону движения группы"
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FormationSlotDef"
          },
          "description": "Слоты — Позиции по порядку заполнения; первая — у точки приказа"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": true
    },
    "FormationSlotDef": {
      "type": "object",
      "properties": {
        "offset": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Смещение — Относительно точки приказа при движении на восток"
        },
        "role": {
          "type": "string",
          "enum": [
            "Auto",
            "Melee",
            "Ranged",
            "Caster",
            "Support",
            "Tank"
          ],
          "description": "Роль — Авто — любой юнит"
        }
      },
      "additionalProperties": true
    }
  }
}
