{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hextactics/ai_profiles.schema.json",
  "title": "профиль ИИ (ai_profiles.json)",
  "type": "object",
  "required": [
    "formatVersion",
    "items"
  ],
  "properties": {
    "formatVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Версия формата; старые версии мигрируются при загрузке"
    },
    "kind": {
      "const": "ai_profiles"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AiProfileDef"
      }
    }
  },
  "$defs": {
    "AiProfileDef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID — Уникальный идентификатор (латиница, цифры, _)"
        },
        "name": {
          "type": "string",
          "description": "Название"
        },
        "description": {
          "type": "string",
          "description": "Описание"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Теги — Теги для правил, навыков и синергий"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Синонимы для поиска — Другие названия, по которым объект находится в поиске и в быстром вводе (например «святой, holy» у «Света»)"
        },
        "group": {
          "type": "string",
          "description": "Категория в библиотеке — Группа для поиска и фильтров библиотеки (например «Боссы»)"
        },
        "version": {
          "type": "integer",
          "description": "Версия — Увеличивается автоматически при публикации изменений"
        },
        "incomplete": {
          "type": "boolean",
          "description": "Неполный (черновик) — Объект сохранён или импортирован без всех зависимостей: он виден в библиотеке, но сценарии с ним не запускаются"
        },
        "advanceWhenIdle": {
          "type": "boolean",
          "description": "Наступать без обзора — Если врагов не видно — идти к стартовой зоне игрока (или центру карты)"
        },
        "aggression": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Агрессивность — 0 — осторожный, 1 — всегда атакует"
        },
        "alert": {
          "type": "boolean",
          "description": "Поднимать тревогу — Сообщать союзникам о замеченном враге"
        },
        "altTargets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AltTargetDef"
          },
          "description": "Альтернативные цели — База уничтожена или недоступна; пусто — из сценария"
        },
        "breakObstacles": {
          "type": "boolean",
          "description": "Ломать препятствия — Путь закрыт разрушаемым препятствием — атакует его"
        },
        "category": {
          "type": "string",
          "enum": [
            "Terrain",
            "Stat",
            "Resource",
            "DamageType",
            "Faction",
            "Unit",
            "Skill",
            "Passive",
            "CellEffect",
            "Synergy",
            "Status",
            "AiProfile",
            "Map",
            "Scenario",
            "MoveCategory",
            "MapTemplate",
            "Layer",
            "Element",
            "RulesPreset",
            "Asset",
            "Vfx",
            "Formation",
            "Origin",
            "GroupPreset",
            "ScalingProfile",
            "GameRules",
            "SquadPreset",
            "ZonePreset",
            "ModifierSet",
            "DifficultyVariant",
            "ObjectPreset",
            "Campaign",
            "RewardSet"
          ]
        },
        "decisionInterval": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 10,
          "description": "Интервал решений, с"
        },
        "displayName": {
          "type": "string"
        },
        "encounter": {
          "anyOf": [
            {
              "$ref": "#/$defs/EncounterDef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Встреча с защитниками — Для врагов на маршруте: преследование, отвлечение, возврат"
        },
        "faceThreats": {
          "type": "boolean",
          "description": "Поворачиваться к угрозе — Разворачиваться лицом к видимому врагу"
        },
        "guardBase": {
          "type": "boolean",
          "description": "Охранять базу — Центр удержания — своя база с наибольшим приоритетом защиты"
        },
        "hazardAvoidance": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Избегание опасностей — Множитель стоимости опасных клеток в маршруте"
        },
        "holdPosition": {
          "type": "boolean",
          "description": "Удерживать позицию"
        },
        "holdRadius": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30,
          "description": "Радиус удержания"
        },
        "keepDistance": {
          "type": "boolean",
          "description": "Держать дистанцию — Отходить, если враг ближе предпочитаемой дистанции"
        },
        "leadAllies": {
          "type": "boolean",
          "description": "Вести союзников — Союзники рядом атакуют цель вожака"
        },
        "patrol": {
          "type": "boolean",
          "description": "Патрулировать — Обходит точки вокруг позиции (или маршрут-патруль) и реагирует в зоне"
        },
        "patrolRadius": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30,
          "description": "Радиус патруля"
        },
        "preferControl": {
          "type": "boolean",
          "description": "Предпочитать контроль — Сначала навыки с оглушением, замедлением, обездвиживанием"
        },
        "preferredRange": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30,
          "description": "Предпочитаемая дистанция — 0 = ближний бой"
        },
        "pursue": {
          "type": "boolean",
          "description": "Преследовать — Идти к последней известной позиции цели"
        },
        "retaliation": {
          "type": "string",
          "enum": [
            "Attacker",
            "Everyone",
            "Flee",
            "Ignore"
          ],
          "description": "Если на мирного напали"
        },
        "retreatHpFraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Отступать при HP ниже"
        },
        "routeFocus": {
          "type": "boolean",
          "description": "Идти по маршруту, не отвлекаясь — Враг волны идёт к цели маршрута и атакует только тех, кто его блокирует"
        },
        "routeOnly": {
          "type": "boolean",
          "description": "Только маршрут — Никогда не переключается на охоту (ТЗ ч. 5, 17.7): не сходит с маршрута ради целей, не преследует, не ищет противника; бьёт только тех, кого достаёт с места, и свою цель в конце маршрута. «Охотится» группы и альтернатива «атаковать защитников» не действуют — с записью в журнал"
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AiRuleDef"
          },
          "description": "Правила поведения — «Если — то — иначе» с приоритетом: поведение (отступить, удерживать, атаковать слабейшего…) и действия из каталога; поведение задаёт первое по приоритету сработавшее правило"
        },
        "stayWithAllies": {
          "type": "boolean",
          "description": "Держаться союзников — Не отходит от своих дальше радиуса удержания"
        },
        "support": {
          "type": "boolean",
          "description": "Поддержка — Лечить/усиливать союзников при возможности"
        },
        "supportHpThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Порог лечения союзника"
        },
        "targetPriority": {
          "type": "string",
          "enum": [
            "Nearest",
            "Weakest",
            "MostDangerous",
            "LowestHpFraction",
            "Isolated",
            "ThreatToBase",
            "ByTypes"
          ],
          "description": "Приоритет целей"
        },
        "targetTypes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Предпочитаемые цели — Теги («tag:x»), категории, ID шаблонов — для приоритета «по тегам и типам»"
        },
        "temperament": {
          "type": "string",
          "enum": [
            "Aggressive",
            "PassiveUntilAttacked"
          ],
          "description": "Характер — «Мирный, пока не атакуют» — не начинает бой сам; способность атаковать при этом остаётся"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": true
    },
    "AiRuleDef": {
      "type": "object",
      "properties": {
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TriggerActionDef"
          },
          "description": "То: действия"
        },
        "cooldown": {
          "type": "number",
          "minimum": 0,
          "maximum": 3600,
          "description": "Перезарядка, с"
        },
        "directive": {
          "type": "string",
          "enum": [
            "None",
            "Attack",
            "AttackWeakest",
            "AttackDangerous",
            "DefendBase",
            "Retreat",
            "Hold",
            "Advance",
            "Support",
            "Guard",
            "ReturnToRoute",
            "Wait"
          ],
          "description": "То: поведение"
        },
        "elseActions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TriggerActionDef"
          },
          "description": "Иначе: действия"
        },
        "elseDirective": {
          "type": "string",
          "enum": [
            "None",
            "Attack",
            "AttackWeakest",
            "AttackDangerous",
            "DefendBase",
            "Retreat",
            "Hold",
            "Advance",
            "Support",
            "Guard",
            "ReturnToRoute",
            "Wait"
          ],
          "description": "Иначе: поведение"
        },
        "name": {
          "type": "string",
          "description": "Название"
        },
        "once": {
          "type": "boolean",
          "description": "Однократно — Иначе — повторно с перезарядкой"
        },
        "priority": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100,
          "description": "Приоритет — Правила проверяются от большего приоритета; поведение задаёт первое сработавшее"
        },
        "when": {
          "$ref": "#/$defs/ConditionDef",
          "description": "Если"
        }
      },
      "additionalProperties": true
    },
    "AltTargetDef": {
      "type": "object",
      "properties": {
        "flag": {
          "type": "string",
          "description": "Флаг события"
        },
        "kind": {
          "type": "string",
          "enum": [
            "OtherBase",
            "AttackDefenders",
            "CaptureObject",
            "BreakObstacle",
            "Stop",
            "Retreat",
            "Event"
          ],
          "description": "Что делать"
        },
        "object": {
          "type": "string",
          "description": "Объект — ID объекта; пусто — ближайшая цель/контрольная точка"
        }
      },
      "additionalProperties": true
    },
    "ConditionDef": {
      "type": "object",
      "properties": {
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Категории врагов — Для подсчёта убитых: категории существ или tag:тег; пусто — все"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConditionDef"
          },
          "description": "Вложенные условия"
        },
        "compare": {
          "type": "string",
          "enum": [
            "AtLeast",
            "AtMost"
          ],
          "description": "Сравнение"
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000,
          "description": "Количество — Убитые/волны/прорывы; дальность для «в дальности»; номер фазы босса; число разрушений и комбинаций"
        },
        "flag": {
          "type": "string",
          "description": "Флаг"
        },
        "fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Доля здоровья"
        },
        "marker": {
          "type": "string",
          "description": "Метка карты — Для разрушения и комбинаций — пусто: где угодно"
        },
        "objectId": {
          "type": "string",
          "description": "Объект (ID)"
        },
        "objectState": {
          "type": "string",
          "description": "Состояние (ID)"
        },
        "objective": {
          "type": "string",
          "description": "Цель (ID)"
        },
        "resource": {
          "type": "string",
          "x-ref": "Resource",
          "description": "Ресурс"
        },
        "seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 36000,
          "description": "Время, с"
        },
        "side": {
          "type": "string",
          "enum": [
            "Player",
            "Enemy",
            "Any"
          ],
          "description": "Сторона"
        },
        "status": {
          "type": "string",
          "x-ref": "Status",
          "description": "Состояние"
        },
        "synergy": {
          "type": "string",
          "x-ref": "Synergy",
          "description": "Синергия"
        },
        "type": {
          "type": "string",
          "enum": [
            "AllEnemiesDead",
            "AllPlayerUnitsDead",
            "SurviveTime",
            "ReachMarker",
            "UnitDead",
            "UnitAlive",
            "KillCount",
            "TimeElapsed",
            "WaveSpawned",
            "All",
            "Any",
            "Not",
            "InOrder",
            "UnitInArea",
            "WaveCleared",
            "WavesCleared",
            "ObjectiveCompleted",
            "ObjectiveFailed",
            "FlagSet",
            "HpBelow",
            "EnemiesLeaked",
            "Always",
            "TargetInRange",
            "EnemySpotted",
            "UnitLeftArea",
            "ResourceReached",
            "HasStatus",
            "FlagTimer",
            "ObstacleDestroyed",
            "BossPhase",
            "SynergyOccurred",
            "Environment",
            "ObjectInState"
          ],
          "description": "Условие"
        },
        "unitTag": {
          "type": "string",
          "description": "Метка юнита — Пусто — сам владелец (босс, носитель состояния, юнит с пассивкой или правилом ИИ)"
        },
        "value": {
          "type": "number",
          "description": "Значение — Ресурс; для состояния — минимум очков/стаков (0 — любое)"
        },
        "variable": {
          "type": "string",
          "description": "Переменная"
        },
        "variableValue": {
          "type": "string",
          "description": "Значение — Равно ли значение переменной этому"
        },
        "wave": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "description": "Волна (индекс)"
        }
      },
      "additionalProperties": true
    },
    "EncounterDef": {
      "type": "object",
      "properties": {
        "allowedTargets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Допустимые цели — Теги («tag:x»), категории, ID шаблонов; пусто — любые"
        },
        "attackMoving": {
          "type": "boolean",
          "description": "Атаковать движущуюся цель"
        },
        "basePriority": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Приоритет базы — 0 — бьётся с любым встречным, 1 — только с блокирующими"
        },
        "distractionSeconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 600,
          "description": "Время отвлечения, с — Сколько можно быть вне маршрута; 0 — без ограничения"
        },
        "mode": {
          "type": "string",
          "enum": [
            "Runner",
            "Hunter",
            "PackGuard",
            "Assassin",
            "Tank",
            "Support"
          ],
          "description": "Поведение при встрече"
        },
        "pursuitRange": {
          "type": "integer",
          "minimum": -1,
          "maximum": 50,
          "description": "Дистанция преследования — Гексов от маршрута; −1 — характеристика «дальность преследования»"
        },
        "returnCondition": {
          "anyOf": [
            {
              "$ref": "#/$defs/UnitConditionDef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Условие возврата — Выполнено — бросает преследование и возвращается на маршрут"
        },
        "throughObstacles": {
          "type": "boolean",
          "description": "Преследовать сквозь препятствия — Нет — бросает цель, если путь к ней вдвое длиннее прямой"
        }
      },
      "additionalProperties": true
    },
    "ShieldSpecDef": {
      "type": "object",
      "properties": {
        "color": {
          "type": "string",
          "pattern": "^(#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?)?$",
          "description": "Цвет"
        },
        "ignoresPeriodic": {
          "type": "boolean",
          "description": "Пропускает периодический урон"
        },
        "name": {
          "type": "string",
          "description": "Название щита"
        },
        "priority": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100,
          "description": "Приоритет расхода — Сначала расходуются щиты с большим приоритетом"
        },
        "protects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Защищает от — Пусто — от любого урона"
        },
        "regenDelay": {
          "type": "number",
          "minimum": 0,
          "maximum": 3600,
          "description": "Задержка восстановления, с — После получения урона"
        },
        "regenPerSecond": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000,
          "description": "Восстановление/с — 0 — не восстанавливается"
        },
        "stacking": {
          "type": "string",
          "enum": [
            "Refresh",
            "Add",
            "Separate",
            "ReplaceIfStronger"
          ],
          "description": "Повторное наложение"
        }
      },
      "additionalProperties": true
    },
    "SkillEffectDef": {
      "type": "object",
      "properties": {
        "aiProfile": {
          "type": "string",
          "x-ref": "AiProfile",
          "description": "Профиль ИИ"
        },
        "amount": {
          "type": "number",
          "description": "Величина — Урон/лечение/очки состояния/изменение ресурса/объём щита; для накопления — изменение очков (стаков), может быть отрицательным"
        },
        "cellEffect": {
          "type": "string",
          "x-ref": "CellEffect",
          "description": "Эффект клетки"
        },
        "chance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Шанс"
        },
        "damageType": {
          "type": "string",
          "x-ref": "DamageType",
          "description": "Тип урона"
        },
        "distance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "description": "Расстояние"
        },
        "duration": {
          "type": "number",
          "minimum": 0,
          "maximum": 3600,
          "description": "Длительность, с — 0 = по умолчанию; для изменения характеристики — до конца боя"
        },
        "facing": {
          "type": "string",
          "enum": [
            "TowardSource",
            "AwayFromSource",
            "Opposite",
            "Random",
            "Set"
          ],
          "description": "Направление взгляда"
        },
        "filter": {
          "$ref": "#/$defs/TargetFilterDef",
          "description": "На кого действует"
        },
        "formula": {
          "type": "string",
          "description": "Формула — Необязательно. Заменяет величину. Переменные: amount, caster_*, target_*, level"
        },
        "healMode": {
          "type": "string",
          "enum": [
            "Flat",
            "PercentMax",
            "PercentMissing"
          ],
          "description": "Режим лечения — Фиксированное, % от максимума или % от недостающего здоровья (величина — проценты)"
        },
        "isGlobal": {
          "type": "boolean"
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Уровень/заряды"
        },
        "obstacleDamage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000,
          "description": "Урон препятствию"
        },
        "requiresHit": {
          "type": "boolean",
          "description": "Требует попадания — Применяется только если бросок попадания успешен"
        },
        "resource": {
          "type": "string",
          "x-ref": "Resource",
          "description": "Ресурс"
        },
        "route": {
          "type": "string",
          "description": "Маршрут карты"
        },
        "scalingFactor": {
