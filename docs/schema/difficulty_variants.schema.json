{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hextactics/difficulty_variants.schema.json",
  "title": "вариант сценария (difficulty_variants.json)",
  "type": "object",
  "required": [
    "formatVersion",
    "items"
  ],
  "properties": {
    "formatVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Версия формата; старые версии мигрируются при загрузке"
    },
    "kind": {
      "const": "difficulty_variants"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DifficultyVariantDef"
      }
    }
  },
  "$defs": {
    "DifficultyVariantDef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID — Уникальный идентификатор (латиница, цифры, _)"
        },
        "name": {
          "type": "string",
          "description": "Название"
        },
        "description": {
          "type": "string",
          "description": "Описание"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Теги — Теги для правил, навыков и синергий"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Синонимы для поиска — Другие названия, по которым объект находится в поиске и в быстром вводе (например «святой, holy» у «Света»)"
        },
        "group": {
          "type": "string",
          "description": "Категория в библиотеке — Группа для поиска и фильтров библиотеки (например «Боссы»)"
        },
        "version": {
          "type": "integer",
          "description": "Версия — Увеличивается автоматически при публикации изменений"
        },
        "incomplete": {
          "type": "boolean",
          "description": "Неполный (черновик) — Объект сохранён или импортирован без всех зависимостей: он виден в библиотеке, но сценарии с ним не запускаются"
        },
        "category": {
          "type": "string",
          "enum": [
            "Terrain",
            "Stat",
            "Resource",
            "DamageType",
            "Faction",
            "Unit",
            "Skill",
            "Passive",
            "CellEffect",
            "Synergy",
            "Status",
            "AiProfile",
            "Map",
            "Scenario",
            "MoveCategory",
            "MapTemplate",
            "Layer",
            "Element",
            "RulesPreset",
            "Asset",
            "Vfx",
            "Formation",
            "Origin",
            "GroupPreset",
            "ScalingProfile",
            "GameRules",
            "SquadPreset",
            "ZonePreset",
            "ModifierSet",
            "DifficultyVariant",
            "ObjectPreset"
          ]
        },
        "displayName": {
          "type": "string"
        },
        "expectedThreat": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000,
          "description": "Ожидаемая угроза врагов — 0 — считается по волнам"
        },
        "modifierSets": {
          "type": "array",
          "items": {
            "type": "string",
            "x-ref": "ModifierSet"
          },
          "description": "Наборы модификаторов — По порядку, после своих наборов сценария"
        },
        "recommendedPower": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Рекомендуемая сила отряда — 0 — не указана"
        },
        "scenario": {
          "type": "string",
          "x-ref": "Scenario",
          "description": "Сценарий"
        },
        "unlockedBy": {
          "type": "string",
          "description": "Открывается после — ID сценария, который надо пройти (кампании — этап 6.8); пусто — открыт"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": true
    }
  }
}
