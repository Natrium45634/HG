{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hextactics/passives.schema.json",
  "title": "пассивная способность (passives.json)",
  "type": "object",
  "required": [
    "formatVersion",
    "items"
  ],
  "properties": {
    "formatVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Версия формата; старые версии мигрируются при загрузке"
    },
    "kind": {
      "const": "passives"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PassiveDef"
      }
    }
  },
  "$defs": {
    "AbsorptionDef": {
      "type": "object",
      "properties": {
        "affectsPeriodic": {
          "type": "boolean",
          "description": "Действует на периодический урон"
        },
        "capPerHit": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000,
          "description": "Предел за удар/тик — 0 — без предела"
        },
        "into": {
          "type": "string",
          "enum": [
            "Health",
            "Resource",
            "Nothing"
          ],
          "description": "Превращается в"
        },
        "match": {
          "type": "string",
          "description": "К чему"
        },
        "order": {
          "type": "string",
          "enum": [
            "AfterShields",
            "BeforeShields"
          ],
          "description": "Порядок — Относительно щитов"
        },
        "percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Поглощение, % — Доля оставшегося урона, которая не наносится"
        },
        "resource": {
          "type": "string",
          "x-ref": "Resource",
          "description": "Ресурс"
        }
      },
      "additionalProperties": true
    },
    "ConditionDef": {
      "type": "object",
      "properties": {
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Категории врагов — Для подсчёта убитых: категории существ или tag:тег; пусто — все"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConditionDef"
          },
          "description": "Вложенные условия"
        },
        "compare": {
          "type": "string",
          "enum": [
            "AtLeast",
            "AtMost"
          ],
          "description": "Сравнение"
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000,
          "description": "Количество — Убитые/волны/прорывы; дальность для «в дальности»; номер фазы босса; число разрушений и комбинаций"
        },
        "flag": {
          "type": "string",
          "description": "Флаг"
        },
        "fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Доля здоровья"
        },
        "marker": {
          "type": "string",
          "description": "Метка карты — Для разрушения и комбинаций — пусто: где угодно"
        },
        "objectId": {
          "type": "string",
          "description": "Объект (ID)"
        },
        "objectState": {
          "type": "string",
          "description": "Состояние (ID)"
        },
        "objective": {
          "type": "string",
          "description": "Цель (ID)"
        },
        "resource": {
          "type": "string",
          "x-ref": "Resource",
          "description": "Ресурс"
        },
        "seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 36000,
          "description": "Время, с"
        },
        "side": {
          "type": "string",
          "enum": [
            "Player",
            "Enemy",
            "Any"
          ],
          "description": "Сторона"
        },
        "status": {
          "type": "string",
          "x-ref": "Status",
          "description": "Состояние"
        },
        "synergy": {
          "type": "string",
          "x-ref": "Synergy",
          "description": "Синергия"
        },
        "type": {
          "type": "string",
          "enum": [
            "AllEnemiesDead",
            "AllPlayerUnitsDead",
            "SurviveTime",
            "ReachMarker",
            "UnitDead",
            "UnitAlive",
            "KillCount",
            "TimeElapsed",
            "WaveSpawned",
            "All",
            "Any",
            "Not",
            "InOrder",
            "UnitInArea",
            "WaveCleared",
            "WavesCleared",
            "ObjectiveCompleted",
            "ObjectiveFailed",
            "FlagSet",
            "HpBelow",
            "EnemiesLeaked",
            "Always",
            "TargetInRange",
            "EnemySpotted",
            "UnitLeftArea",
            "ResourceReached",
            "HasStatus",
            "FlagTimer",
            "ObstacleDestroyed",
            "BossPhase",
            "SynergyOccurred",
            "Environment",
            "ObjectInState"
          ],
          "description": "Условие"
        },
        "unitTag": {
          "type": "string",
          "description": "Метка юнита — Пусто — сам владелец (босс, носитель состояния, юнит с пассивкой или правилом ИИ)"
        },
        "value": {
          "type": "number",
          "description": "Значение — Ресурс; для состояния — минимум очков/стаков (0 — любое)"
        },
        "variable": {
          "type": "string",
          "description": "Переменная"
        },
        "variableValue": {
          "type": "string",
          "description": "Значение — Равно ли значение переменной этому"
        },
        "wave": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "description": "Волна (индекс)"
        }
      },
      "additionalProperties": true
    },
    "ConversionDef": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "description": "Из — Какой урон преобразуется"
        },
        "percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Доля, % — Часть урона, которая становится другим типом (до сопротивлений)"
        },
        "to": {
          "type": "string",
          "x-ref": "DamageType",
          "description": "В тип урона"
        }
      },
      "additionalProperties": true
    },
    "DamageModDef": {
      "type": "object",
      "properties": {
        "match": {
          "type": "string",
          "description": "К чему — Любой урон, тип урона (и его потомки), элемент, категория или тег"
        },
        "percent": {
          "type": "number",
          "minimum": -500,
          "maximum": 500,
          "description": "Модификатор, % — Получаемый урон × (1 + V/100): +100 — двойной, +500 — шестикратный, −50 — вдвое меньше, −100 и ниже — нет урона (не лечит)"
        }
      },
      "additionalProperties": true
    },
    "DefenseDef": {
      "type": "object",
      "properties": {
        "absorptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AbsorptionDef"
          },
          "description": "Поглощение"
        },
        "conversions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConversionDef"
          },
          "description": "Преобразование входящего урона"
        },
        "critImmune": {
          "type": "boolean",
          "description": "Иммунитет к критам"
        },
        "flatReductions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FlatReductionDef"
          },
          "description": "Фиксированное снижение — После сопротивлений и брони"
        },
        "immune": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Иммунитет к урону — Тип, элемент, категория или тег — урон 0"
        },
        "isEmpty": {
          "type": "boolean"
        },
        "modifiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DamageModDef"
          },
          "description": "Сопротивления и уязвимости — Модификаторы складываются; итог ограничен правилами (по умолчанию −500…+500 %)"
        },
        "reflections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReflectionDef"
          },
          "description": "Отражение"
        }
      },
      "additionalProperties": true
    },
    "FlatReductionDef": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000,
          "description": "Снижение за удар — Отрицательное — дополнительный получаемый урон"
        },
        "match": {
          "type": "string",
          "description": "К чему"
        }
      },
      "additionalProperties": true
    },
    "ModifierDef": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "description": "Категория — Из одной категории действует только один (наибольший по модулю)"
        },
        "hitTag": {
          "type": "string",
          "description": "Тег удара — Удары этапов с этим тегом (например finisher)"
        },
        "isPercentLike": {
          "type": "boolean"
        },
        "match": {
          "type": "string",
          "description": "Тип урона — Тип, элемент (el:), категория (cat:), тег (tag:) или * — любой"
        },
        "mode": {
          "type": "string",
          "enum": [
            "FlatBefore",
            "Percent",
            "Multiplier",
            "Max",
            "Min",
            "Priority",
            "Exclusive",
            "FlatAfter"
          ],
          "description": "Суммирование"
        },
        "perEach": {
          "anyOf": [
            {
              "$ref": "#/$defs/PerEachDef"
            },
            {
              "type": "null"
            }
          ],
          "description": "За каждого — Величина умножается на число учитываемых юнитов (с пределом)"
        },
        "priority": {
          "type": "integer",
          "description": "Приоритет — Для «приоритетного источника»: действует только наибольший"
        },
        "resource": {
          "type": "string",
          "x-ref": "Resource",
          "description": "Ресурс"
        },
        "rule": {
          "type": "string",
          "enum": [
            "Nearest",
            "LowestHp",
            "LowestHpFraction",
            "MostDangerous",
            "NearestToProtected",
            "Boss",
            "WithTag",
            "BlockedByMe",
            "BlockingMe",
            "CurrentTarget",
            "Random",
            "Farthest",
            "HighestHp",
            "HighestMaxHp",
            "LowestMaxHp",
            "HighestPower",
            "LowestPower",
            "HighestMagicPower",
            "LowestMagicPower",
            "BossOrElite",
            "Vulnerable",
            "WithStatus",
            "Killable",
            "MostEnemiesNearby"
          ],
          "description": "Правило выбора цели — Ставится первым в автоматическом выборе цели юнита"
        },
        "ruleTag": {
          "type": "string",
          "description": "Тег / состояние правила"
        },
        "skill": {
          "type": "string",
          "x-ref": "Skill",
          "description": "Только навык"
        },
        "skillTag": {
          "type": "string",
          "description": "Только навыки с тегом — Пусто — любые"
        },
        "stat": {
          "type": "string",
          "x-ref": "Stat",
          "description": "Характеристика"
        },
        "status": {
          "type": "string",
          "description": "Состояние — Иммунитет к состоянию (или tag:тег); пусто — иммунитет к типу урона"
        },
        "target": {
          "type": "string",
          "enum": [
            "Stat",
            "ResourceMax",
            "ResourceRegen",
            "IncomingDamage",
            "OutgoingDamage",
            "HitPower",
            "HitCount",
            "SkillCost",
            "Immunity",
            "TargetChoice",
            "TerrainCost",
            "Reflection",
            "Absorption"
          ],
          "description": "Что меняется"
        },
        "terrain": {
          "type": "string",
          "description": "Поверхность — ID местности, tag:тег или kind:вид"
        },
        "value": {
          "type": "number",
          "description": "Величина — Проценты: 25 = +25 %, −75 = −75 %; множитель: 1,2; прибавки — в единицах параметра; количество ударов — штуки"
        },
        "vsTypes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Против типов — Цели (для наносимого) или атакующие (для входящего): категория, ID юнита, tag:, role:; пусто — любые"
        }
      },
      "additionalProperties": true
    },
    "OffenseDef": {
      "type": "object",
      "properties": {
        "bonuses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DamageModDef"
          },
          "description": "Бонусы урона, % — Наносимый урон × (1 + Σ/100) по типу, элементу или категории"
        },
        "conversions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConversionDef"
          },
          "description": "Преобразование наносимого урона"
        },
        "isEmpty": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "PassiveDef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID — Уникальный идентификатор (латиница, цифры, _)"
        },
        "name": {
          "type": "string",
          "description": "Название"
        },
        "description": {
          "type": "string",
          "description": "Описание"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Теги — Теги для правил, навыков и синергий"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Синонимы для поиска — Другие названия, по которым объект находится в поиске и в быстром вводе (например «святой, holy» у «Света»)"
        },
        "group": {
          "type": "string",
          "description": "Категория в библиотеке — Группа для поиска и фильтров библиотеки (например «Боссы»)"
        },
        "version": {
          "type": "integer",
          "description": "Версия — Увеличивается автоматически при публикации изменений"
        },
        "incomplete": {
          "type": "boolean",
          "description": "Неполный (черновик) — Объект сохранён или импортирован без всех зависимостей: он виден в библиотеке, но сценарии с ним не запускаются"
        },
        "action": {
          "type": "string",
          "enum": [
            "None",
            "EffectsOnSelf",
            "EffectsOnSource",
            "CounterAttack",
            "UseSkillOnSource"
          ],
          "description": "Действие"
        },
        "activeSeconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 3600,
          "description": "Действует после срабатывания, с — Для срабатывающих: модификаторы действуют N с после события"
        },
        "apCost": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Стоимость ОД реакции"
        },
        "auraAffects": {
          "type": "string",
          "enum": [
            "Allies",
            "Enemies",
            "All"
          ],
          "description": "Аура действует на"
        },
        "auraIncludesSelf": {
          "type": "boolean",
          "description": "Аура и на владельца"
        },
        "auraMaxTargets": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "description": "Не более получателей — Ближайшие к владельцу (ТЗ ч. 5, 14.2); 0 — сколько поместится в радиусе"
        },
        "auraPassives": {
          "type": "array",
          "items": {
            "type": "string",
            "x-ref": "Passive"
          },
          "description": "Пассивы ауры — Что получают юниты в ауре; пусто — модификаторы этого пассива"
        },
        "auraRadius": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "description": "Радиус ауры — 0 — не аура; иначе действует на юнитов вокруг владельца"
        },
        "auraTypes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Аура только для — Теги или категории получателей («tag:стая», ID категории); пусто — все"
        },
        "category": {
          "type": "string",
          "enum": [
            "Terrain",
            "Stat",
            "Resource",
            "DamageType",
            "Faction",
            "Unit",
            "Skill",
            "Passive",
            "CellEffect",
            "Synergy",
            "Status",
            "AiProfile",
            "Map",
            "Scenario",
            "MoveCategory",
            "MapTemplate",
            "Layer",
            "Element",
            "RulesPreset",
            "Asset",
            "Vfx",
            "Formation",
            "Origin",
            "GroupPreset",
            "ScalingProfile",
            "GameRules",
            "SquadPreset",
            "ZonePreset",
            "ModifierSet",
            "DifficultyVariant",
            "ObjectPreset"
          ]
        },
        "chainReaction": {
          "type": "boolean",
          "description": "Цепная реакция — Эффект пассива может снова запустить этот же пассив (с пределом глубины)"
        },
        "chance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Шанс"
        },
        "checkInterval": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 60,
          "description": "Частота проверки, с — Как часто пересчитываются условия и ауры"
        },
        "condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConditionDef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Дополнительное условие — Пассивка срабатывает, только если условие выполнено (без метки — для самого владельца)"
        },
        "cooldown": {
          "type": "number",
          "minimum": 0,
          "maximum": 3600,
          "description": "Перезарядка, с"
        },
        "deactivateOn": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "Always",
                "OnDamaged",
                "OnAttackNoticed",
                "OnHitEnemy",
                "OnKill",
                "OnAllyDied",
                "OnLowHp",
                "Periodic",
                "OnEnemySpotted",
                "OnCrit",
                "OnMoved",
                "OnSkillUsed",
                "OnHpLost",
                "OnEnemyEnteredArea"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Событие деактивации — Досрочно снимает действие после срабатывания"
        },
        "defense": {
          "$ref": "#/$defs/DefenseDef",
          "description": "Защита от урона — Действует постоянно"
        },
        "displayName": {
          "type": "string"
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SkillEffectDef"
          },
          "description": "Эффекты"
        },
        "groupRule": {
          "type": "string",
          "enum": [
            "Highest",
            "Latest",
            "First",
            "All"
          ],
          "description": "Правило группы — Если задана группа наложения"
        },
        "hpLoss": {
          "type": "number",
          "minimum": 1,
          "maximum": 100000,
          "description": "Потеря здоровья — Для «потерял N здоровья»"
        },
        "hpThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Порог HP — Доля HP для «при низком HP»"
        },
        "icon": {
          "type": "string",
          "description": "Значок — 1–2 символа в панели юнита"
        },
        "interval": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 3600,
          "description": "Интервал, с — Для периодического срабатывания"
        },
        "kind": {
          "type": "string",
          "enum": [
            "Passive",
            "Talent"
          ],
          "description": "Вид — Пассивное умение или талант (раса, происхождение, роль, уникальная особенность)"
        },
        "maxChainDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "Глубина цепи"
        },
        "maxStacks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Макс. стаков"
        },
        "maxTriggers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000,
          "description": "Макс. срабатываний за бой — 0 — без ограничения"
        },
        "modifiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModifierDef"
          },
          "description": "Модификаторы — Что меняется и как суммируется"
        },
        "offense": {
          "$ref": "#/$defs/OffenseDef",
          "description": "Атака — Бонусы урона, действуют постоянно"
        },
        "order": {
          "type": "integer",
          "minimum": -1000,
          "maximum": 1000,
          "description": "Порядок применения — Меньше — раньше (для одинаковых режимов суммирования не важен)"
        },
