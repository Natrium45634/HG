{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hextactics/rules.schema.json",
  "title": "Правила боя (rules.json)",
  "type": "object",
  "required": [
    "formatVersion",
    "rules"
  ],
  "properties": {
    "formatVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Версия формата; старые версии мигрируются при загрузке"
    },
    "kind": {
      "const": "rules"
    },
    "rules": {
      "$ref": "#/$defs/RulesDef"
    }
  },
  "$defs": {
    "ApRules": {
      "type": "object",
      "properties": {
        "defendBlockBonus": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Бонус блока в стойке"
        },
        "defendCost": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "ОД стойки защиты"
        },
        "defendEvasionBonus": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Бонус уклонения в стойке"
        },
        "defendRegenMultiplier": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Восстановление ОД в стойке — Множитель"
        },
        "movePerCost": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "ОД за единицу стоимости движения"
        },
        "reactionsRespectReserve": {
          "type": "boolean",
          "description": "Реакции не трогают резерв — Реакции тратят только свободные ОД (текущие − резерв)"
        }
      },
      "additionalProperties": true
    },
    "AssetLimitsDef": {
      "type": "object",
      "properties": {
        "maxImageMb": {
          "type": "number",
          "minimum": 1,
          "maximum": 1024,
          "description": "Макс. размер файла изображения, МБ"
        },
        "maxModelMb": {
          "type": "number",
          "minimum": 1,
          "maximum": 4096,
          "description": "Макс. размер файла модели, МБ"
        },
        "maxSoundMb": {
          "type": "number",
          "minimum": 1,
          "maximum": 1024,
          "description": "Макс. размер звука, МБ"
        },
        "textures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TextureLimitDef"
          },
          "description": "Текстуры по назначению"
        },
        "warnAnimationSeconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 3600,
          "description": "Предупреждение: длительность анимации, с"
        },
        "warnBones": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "description": "Предупреждение: костей скелета"
        },
        "warnModelMb": {
          "type": "number",
          "minimum": 1,
          "maximum": 4096,
          "description": "Предупреждение по размеру модели, МБ"
        },
        "warnSoundSeconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 3600,
          "description": "Предупреждение: длительность звука, с"
        },
        "warnTotalMb": {
          "type": "number",
          "minimum": 1,
          "maximum": 100000,
          "description": "Предупреждение: суммарный объём ресурсов, МБ — Для всего пакета"
        },
        "warnTriangles": {
          "type": "integer",
          "minimum": 100,
          "maximum": 100000000,
          "description": "Предупреждение: треугольников персонажа"
        }
      },
      "additionalProperties": true
    },
    "AutoAttackRules": {
      "type": "object",
      "properties": {
        "aiUnits": {
          "type": "boolean",
          "description": "Для юнитов под ИИ — ИИ и автоатаки используют одни и те же ОД; ручные приказы ИИ имеют приоритет"
        },
        "bossTag": {
          "type": "string",
          "description": "Тег босса"
        },
        "eliteTag": {
          "type": "string",
          "description": "Тег элиты — Для правила «босс или элита»"
        },
        "enabled": {
          "type": "boolean",
          "description": "Автоатаки включены"
        },
        "playerUnits": {
          "type": "boolean",
          "description": "Для юнитов игрока"
        },
        "protectedTag": {
          "type": "string",
          "description": "Тег защищаемого объекта — Юниты/объекты с этим тегом — для правила «ближайший к защищаемому»"
        }
      },
      "additionalProperties": true
    },
    "AutopauseRules": {
      "type": "object",
      "properties": {
        "allyCriticalDamage": {
          "type": "boolean",
          "description": "Критический урон союзнику"
        },
        "commandFailed": {
          "type": "boolean",
          "description": "Отмена команды"
        },
        "criticalHpFraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Порог критического HP"
        },
        "enemySpotted": {
          "type": "boolean",
          "description": "Обнаружен враг"
        },
        "pathUnavailable": {
          "type": "boolean",
          "description": "Маршрут недоступен"
        },
        "queueEmpty": {
          "type": "boolean",
          "description": "Очередь юнита опустела"
        },
        "skillInterrupted": {
          "type": "boolean",
          "description": "Прерывание навыка"
        },
        "unitDied": {
          "type": "boolean",
          "description": "Гибель юнита"
        },
        "waveStarted": {
          "type": "boolean",
          "description": "Начало волны"
        }
      },
      "additionalProperties": true
    },
    "CombatRules": {
      "type": "object",
      "properties": {
        "baseHit": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Базовый шанс попадания"
        },
        "coverFactor": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "Вес укрытия"
        },
        "damageFormula": {
          "type": "string",
          "description": "Формула урона — Пусто — встроенная. Переменные: raw, armor, resist, crit, surprise, block"
        },
        "friendlyFire": {
          "type": "boolean",
          "description": "Урон по союзникам — Области задевают союзников, если эффект это допускает"
        },
        "healCanCrit": {
          "type": "boolean",
          "description": "Лечение может быть критическим"
        },
        "hitFormula": {
          "type": "string",
          "description": "Формула шанса попадания — Пусто — встроенная. Переменные: base, accuracy, evasion, height, surprise, cover"
        },
        "maxHit": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Макс. шанс попадания"
        },
        "minArmorFraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Мин. доля урона после брони"
        },
        "minDamageOnHit": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Мин. урон при попадании"
        },
        "minHit": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Мин. шанс попадания"
        }
      },
      "additionalProperties": true
    },
    "ComponentCurveDef": {
      "type": "object",
      "properties": {
        "cap": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000,
          "description": "Предел — Наибольшее значение составляющей (к эталону); 0 — без предела"
        },
        "exponent": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 2,
          "description": "Степень"
        },
        "kind": {
          "type": "string",
          "enum": [
            "Linear",
            "Power",
            "Log"
          ],
          "description": "Зависимость"
        }
      },
      "additionalProperties": true
    },
    "CritRulesDef": {
      "type": "object",
      "properties": {
        "flankBonus": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "description": "Бонус шанса: фланг"
        },
        "meleeBonus": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "description": "Бонус шанса: ближний бой"
        },
        "minMultiplier": {
          "type": "number",
          "minimum": 1,
          "maximum": 10,
          "description": "Мин. множитель крита — Множитель после защиты от критов не ниже"
        },
        "rangedBonus": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "description": "Бонус шанса: дальний бой"
        },
        "rearBonus": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "description": "Бонус шанса: тыл"
        },
        "spellBonus": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "description": "Бонус шанса: заклинания"
        }
      },
      "additionalProperties": true
    },
    "DamageRulesDef": {
      "type": "object",
      "properties": {
        "adminBreakdown": {
          "type": "boolean",
          "description": "Подробный разбор в журнале — В административном режиме — каждый шаг расчёта"
        },
        "crit": {
          "$ref": "#/$defs/CritRulesDef",
          "description": "Криты"
        },
        "maxTotalPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 500,
          "description": "Верхний предел суммы модификаторов, %"
        },
        "minTotalPercent": {
          "type": "number",
          "minimum": -500,
          "maximum": 0,
          "description": "Нижний предел суммы модификаторов, % — −500 — допускается полное гашение"
        },
        "overhealShieldDuration": {
          "type": "number",
          "minimum": 0,
          "maximum": 3600,
          "description": "Длительность щита от излишка, с"
        },
        "overhealShieldMaxPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 500,
          "description": "Макс. щит от излишка, % HP"
        },
        "overhealToShieldPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Избыточное лечение → щит, % — Доля излишка лечения, превращаемая в щит (0 — выкл.)"
        },
        "reflectMaxDepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "description": "Глубина цепочки отражения — 1 — отражённый урон больше не отражается"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DamageSourceRuleDef"
          },
          "description": "Правила источников — Исключения единого порядка расчёта для каждого источника урона"
        }
      },
      "additionalProperties": true
    },
    "DamageSourceRuleDef": {
      "type": "object",
      "properties": {
        "absorption": {
          "type": "boolean",
          "description": "Поглощение"
        },
        "armor": {
          "type": "boolean",
          "description": "Учитывает броню — Если тип урона учитывает броню"
        },
        "attackerBonuses": {
          "type": "boolean",
          "description": "Бонусы атакующего — Характеристики и бонусы урона того, кто вызвал урон"
        },
        "canCrit": {
          "type": "boolean",
          "description": "Может критовать"
        },
        "elementEffects": {
          "type": "boolean",
          "description": "Взаимодействия элементов"
        },
        "reflection": {
          "type": "boolean",
          "description": "Отражение"
        },
        "rollHit": {
          "type": "boolean",
          "description": "Бросок попадания — Для источников без собственного броска (навыки бросают сами)"
        },
        "shields": {
          "type": "boolean",
          "description": "Щиты"
        },
        "source": {
          "type": "string",
          "enum": [
            "Skill",
            "AutoAttack",
            "Periodic",
            "CellEffect",
            "Terrain",
            "Synergy",
            "Reflection",
            "Fall",
            "Scenario",
            "Passive",
            "Other"
          ],
          "description": "Источник"
        }
      },
      "additionalProperties": true
    },
    "DamageTypeWeightDef": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "x-ref": "DamageType",
          "description": "Тип урона"
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Доля — Насколько часто этот урон встречается в проекте"
        }
      },
      "additionalProperties": true
    },
    "DeathRules": {
      "type": "object",
      "properties": {
        "corpseCellEffect": {
          "type": "string",
          "x-ref": "CellEffect",
          "description": "Эффект клетки при смерти"
        },
        "summonsDieWithOwner": {
          "type": "boolean",
          "description": "Призванные исчезают со смертью призывателя"
        }
      },
      "additionalProperties": true
    },
    "DetectionRules": {
      "type": "object",
      "properties": {
        "blindNoticeFactor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Множитель замечания при ослеплении"
        },
        "darknessNoticePenalty": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Штраф замечания от темноты — Умножается на темноту карты (0..1)"
        },
        "noSectorNotice": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Без секторов: шанс заметить — Для целей без направления взгляда или с круговым восприятием"
        },
        "noSectorSurprise": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Без секторов: шанс неожиданности"
        },
        "noticeFreeDistance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50,
          "description": "Дистанция без штрафа"
        },
        "noticePenaltyPerHex": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Штраф замечания за гекс"
        },
        "sectors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SectorRule"
          },
          "description": "Секторы — Фронт, ближний фланг, дальний фланг, тыл"
        },
        "surpriseAccuracy": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "description": "Неожиданность: бонус точности"
        },
        "surpriseBonusVsUnaware": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Бонус неожиданности, если цель не видит"
        },
        "surpriseCrit": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "description": "Неожиданность: бонус крита"
        },
        "surpriseDamageMul": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Неожиданность: множитель урона"
        },
        "surpriseInterrupt": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "description": "Неожиданность: бонус прерывания"
        },
        "unnoticedEvasionFactor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Уклонение от незамеченной атаки — Множитель уклонения"
        },
        "unseenNoticeFactor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Множитель замечания, если цель не видит атакующего"
        }
      },
      "additionalProperties": true
    },
    "EnvironmentVisualsDef": {
      "type": "object",
      "properties": {
        "effectAppear": {
          "type": "string",
          "x-ref": "Vfx",
          "description": "Появление эффекта клетки — Если у эффекта клетки не задан свой"
        },
        "fall": {
          "type": "string",
          "x-ref": "Vfx",
          "description": "Падение в яму"
        },
        "hit": {
          "type": "string",
          "x-ref": "Vfx",
          "description": "Попадание (урон)"
        },
        "hitSound": {
          "type": "string",
          "x-ref": "Asset",
          "description": "Звук попадания"
        },
        "obstacleDestroyed": {
          "type": "string",
          "x-ref": "Vfx",
          "description": "Разрушение препятствия"
        },
        "terrainChanged": {
          "type": "string",
          "x-ref": "Vfx",
          "description": "Изменение местности"
        },
        "trapTriggered": {
          "type": "string",
          "x-ref": "Vfx",
          "description": "Срабатывание ловушки"
        },
        "unitDeath": {
          "type": "string",
          "x-ref": "Vfx",
          "description": "Гибель юнита"
        },
        "unitSpawn": {
          "type": "string",
          "x-ref": "Vfx",
          "description": "Появление юнита"
        }
      },
      "additionalProperties": true
    },
    "FailurePolicyDef": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "Skip",
            "CancelQueue",
            "Wait",
            "Repath"
          ],
          "description": "Действие"
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "description": "Попыток пересчёта"
        },
        "then": {
          "type": "string",
          "enum": [
            "Skip",
            "CancelQueue",
            "Wait",
            "Repath"
          ],
          "description": "Затем — Если ожидание/пересчёт не помогли"
        },
        "waitSeconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 600,
          "description": "Ждать, с"
        }
      },
      "additionalProperties": true
    },
    "HeightRules": {
      "type": "object",
      "properties": {
        "accuracyPerLevel": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "description": "Точность за уровень превосходства"
        },
        "climbCostPerLevel": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Стоимость подъёма за уровень"
        },
        "descendCostPerLevel": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Стоимость спуска за уровень"
        },
        "eyeHeight": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Высота глаз, уровней"
        },
        "maxClimb": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "description": "Макс. подъём за шаг"
        },
        "maxDrop": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "description": "Макс. спуск за шаг"
        },
        "rangePerLevel": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Дальность за уровень (дистанц.)"
        },
        "terrainBlocksLoS": {
          "type": "boolean",
          "description": "Рельеф блокирует обзор"
        }
      },
      "additionalProperties": true
    },
    "InfoDisclosureDef": {
      "type": "object",
      "properties": {
        "facing": {
          "type": "string",
          "enum": [
            "Always",
            "WhenVisible",
            "AfterSeen",
            "AfterObserved",
            "Never"
          ],
          "description": "Направление взгляда"
        },
        "health": {
          "type": "string",
          "enum": [
            "Always",
            "WhenVisible",
            "AfterSeen",
            "AfterObserved",
            "Never"
          ],
          "description": "Здоровье"
        },
        "intent": {
          "type": "string",
          "enum": [
            "Always",
            "WhenVisible",
            "AfterSeen",
            "AfterObserved",
            "Never"
          ],
          "description": "Намерение — Что готовит, куда идёт, кого атакует"
        },
        "nameAndType": {
          "type": "string",
          "enum": [
            "Always",
            "WhenVisible",
            "AfterSeen",
            "AfterObserved",
            "Never"
          ],
          "description": "Имя и тип"
        },
        "panelEnabled": {
          "type": "boolean",
          "description": "Панель доступна — Открывать информационную панель по клику на врага"
        },
        "resistances": {
          "type": "string",
          "enum": [
            "Always",
            "WhenVisible",
            "AfterSeen",
            "AfterObserved",
            "Never"
          ],
          "description": "Сопротивления и уязвимости — «После наблюдения» — после попадания этим типом урона"
        },
        "resources": {
          "type": "string",
          "enum": [
            "Always",
            "WhenVisible",
            "AfterSeen",
            "AfterObserved",
            "Never"
          ],
          "description": "Ресурсы"
        },
        "skills": {
          "type": "string",
          "enum": [
            "Always",
            "WhenVisible",
            "AfterSeen",
            "AfterObserved",
            "Never"
          ],
          "description": "Навыки — «После наблюдения» — после того как игрок видел применение"
        },
        "statuses": {
          "type": "string",
          "enum": [
            "Always",
            "WhenVisible",
            "AfterSeen",
            "AfterObserved",
            "Never"
          ],
