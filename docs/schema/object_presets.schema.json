{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hextactics/object_presets.schema.json",
  "title": "пресет объекта (object_presets.json)",
  "type": "object",
  "required": [
    "formatVersion",
    "items"
  ],
  "properties": {
    "formatVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Версия формата; старые версии мигрируются при загрузке"
    },
    "kind": {
      "const": "object_presets"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ObjectPresetDef"
      }
    }
  },
  "$defs": {
    "AbsorptionDef": {
      "type": "object",
      "properties": {
        "affectsPeriodic": {
          "type": "boolean",
          "description": "Действует на периодический урон"
        },
        "capPerHit": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000,
          "description": "Предел за удар/тик — 0 — без предела"
        },
        "into": {
          "type": "string",
          "enum": [
            "Health",
            "Resource",
            "Nothing"
          ],
          "description": "Превращается в"
        },
        "match": {
          "type": "string",
          "description": "К чему"
        },
        "order": {
          "type": "string",
          "enum": [
            "AfterShields",
            "BeforeShields"
          ],
          "description": "Порядок — Относительно щитов"
        },
        "percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Поглощение, % — Доля оставшегося урона, которая не наносится"
        },
        "resource": {
          "type": "string",
          "x-ref": "Resource",
          "description": "Ресурс"
        }
      },
      "additionalProperties": true
    },
    "ConditionDef": {
      "type": "object",
      "properties": {
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Категории врагов — Для подсчёта убитых: категории существ или tag:тег; пусто — все"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConditionDef"
          },
          "description": "Вложенные условия"
        },
        "compare": {
          "type": "string",
          "enum": [
            "AtLeast",
            "AtMost"
          ],
          "description": "Сравнение"
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000,
          "description": "Количество — Убитые/волны/прорывы; дальность для «в дальности»; номер фазы босса; число разрушений и комбинаций"
        },
        "flag": {
          "type": "string",
          "description": "Флаг"
        },
        "fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Доля здоровья"
        },
        "marker": {
          "type": "string",
          "description": "Метка карты — Для разрушения и комбинаций — пусто: где угодно"
        },
        "objectId": {
          "type": "string",
          "description": "Объект (ID)"
        },
        "objectState": {
          "type": "string",
          "description": "Состояние (ID)"
        },
        "objective": {
          "type": "string",
          "description": "Цель (ID)"
        },
        "resource": {
          "type": "string",
          "x-ref": "Resource",
          "description": "Ресурс"
        },
        "seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 36000,
          "description": "Время, с"
        },
        "side": {
          "type": "string",
          "enum": [
            "Player",
            "Enemy",
            "Any"
          ],
          "description": "Сторона"
        },
        "status": {
          "type": "string",
          "x-ref": "Status",
          "description": "Состояние"
        },
        "synergy": {
          "type": "string",
          "x-ref": "Synergy",
          "description": "Синергия"
        },
        "type": {
          "type": "string",
          "enum": [
            "AllEnemiesDead",
            "AllPlayerUnitsDead",
            "SurviveTime",
            "ReachMarker",
            "UnitDead",
            "UnitAlive",
            "KillCount",
            "TimeElapsed",
            "WaveSpawned",
            "All",
            "Any",
            "Not",
            "InOrder",
            "UnitInArea",
            "WaveCleared",
            "WavesCleared",
            "ObjectiveCompleted",
            "ObjectiveFailed",
            "FlagSet",
            "HpBelow",
            "EnemiesLeaked",
            "Always",
            "TargetInRange",
            "EnemySpotted",
            "UnitLeftArea",
            "ResourceReached",
            "HasStatus",
            "FlagTimer",
            "ObstacleDestroyed",
            "BossPhase",
            "SynergyOccurred",
            "Environment",
            "ObjectInState"
          ],
          "description": "Условие"
        },
        "unitTag": {
          "type": "string",
          "description": "Метка юнита — Пусто — сам владелец (босс, носитель состояния, юнит с пассивкой или правилом ИИ)"
        },
        "value": {
          "type": "number",
          "description": "Значение — Ресурс; для состояния — минимум очков/стаков (0 — любое)"
        },
        "variable": {
          "type": "string",
          "description": "Переменная"
        },
        "variableValue": {
          "type": "string",
          "description": "Значение — Равно ли значение переменной этому"
        },
        "wave": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "description": "Волна (индекс)"
        }
      },
      "additionalProperties": true
    },
    "ConversionDef": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "description": "Из — Какой урон преобразуется"
        },
        "percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Доля, % — Часть урона, которая становится другим типом (до сопротивлений)"
        },
        "to": {
          "type": "string",
          "x-ref": "DamageType",
          "description": "В тип урона"
        }
      },
      "additionalProperties": true
    },
    "DamageModDef": {
      "type": "object",
      "properties": {
        "match": {
          "type": "string",
          "description": "К чему — Любой урон, тип урона (и его потомки), элемент, категория или тег"
        },
        "percent": {
          "type": "number",
          "minimum": -500,
          "maximum": 500,
          "description": "Модификатор, % — Получаемый урон × (1 + V/100): +100 — двойной, +500 — шестикратный, −50 — вдвое меньше, −100 и ниже — нет урона (не лечит)"
        }
      },
      "additionalProperties": true
    },
    "DefenseDef": {
      "type": "object",
      "properties": {
        "absorptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AbsorptionDef"
          },
          "description": "Поглощение"
        },
        "conversions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConversionDef"
          },
          "description": "Преобразование входящего урона"
        },
        "critImmune": {
          "type": "boolean",
          "description": "Иммунитет к критам"
        },
        "flatReductions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FlatReductionDef"
          },
          "description": "Фиксированное снижение — После сопротивлений и брони"
        },
        "immune": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Иммунитет к урону — Тип, элемент, категория или тег — урон 0"
        },
        "isEmpty": {
          "type": "boolean"
        },
        "modifiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DamageModDef"
          },
          "description": "Сопротивления и уязвимости — Модификаторы складываются; итог ограничен правилами (по умолчанию −500…+500 %)"
        },
        "reflections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReflectionDef"
          },
          "description": "Отражение"
        }
      },
      "additionalProperties": true
    },
    "FlatReductionDef": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000,
          "description": "Снижение за удар — Отрицательное — дополнительный получаемый урон"
        },
        "match": {
          "type": "string",
          "description": "К чему"
        }
      },
      "additionalProperties": true
    },
    "InteractionDef": {
      "type": "object",
      "properties": {
        "apCost": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Стоимость ОД"
        },
        "cooldown": {
          "type": "number",
          "minimum": 0,
          "maximum": 3600,
          "description": "Перезарядка, с"
        },
        "duration": {
          "type": "number",
          "minimum": 0,
          "maximum": 60,
          "description": "Длительность, с — Юнит занят; оглушение или гибель прерывают"
        },
        "effect": {
          "type": "string",
          "enum": [
            "SetState",
            "NextState",
            "Signal"
          ],
          "description": "Что делает"
        },
        "once": {
          "type": "boolean",
          "description": "Один раз"
        },
        "prompt": {
          "type": "string",
          "description": "Надпись — Что видит игрок: «Опустить мост», «Нажать рычаг»"
        },
        "range": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "description": "Дистанция, гексов — От любого гекса объекта"
        },
        "requiredStates": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Только в состояниях — ID; пусто — в любом"
        },
        "state": {
          "type": "string",
          "description": "Состояние — Для «Перевести в состояние»"
        },
        "target": {
          "type": "string",
          "description": "Объект-получатель — ID объекта сценария"
        },
        "targetState": {
          "type": "string",
          "description": "Его состояние — Пусто — следующее"
        },
        "who": {
          "type": "string",
          "enum": [
            "Player",
            "Allies",
            "Enemies",
            "Anyone"
          ],
          "description": "Кто"
        }
      },
      "additionalProperties": true
    },
    "ObjectPresetDef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID — Уникальный идентификатор (латиница, цифры, _)"
        },
        "name": {
          "type": "string",
          "description": "Название"
        },
        "description": {
          "type": "string",
          "description": "Описание"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Теги — Теги для правил, навыков и синергий"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Синонимы для поиска — Другие названия, по которым объект находится в поиске и в быстром вводе (например «святой, holy» у «Света»)"
        },
        "group": {
          "type": "string",
          "description": "Категория в библиотеке — Группа для поиска и фильтров библиотеки (например «Боссы»)"
        },
        "version": {
          "type": "integer",
          "description": "Версия — Увеличивается автоматически при публикации изменений"
        },
        "incomplete": {
          "type": "boolean",
          "description": "Неполный (черновик) — Объект сохранён или импортирован без всех зависимостей: он виден в библиотеке, но сценарии с ним не запускаются"
        },
        "category": {
          "type": "string",
          "enum": [
            "Terrain",
            "Stat",
            "Resource",
            "DamageType",
            "Faction",
            "Unit",
            "Skill",
            "Passive",
            "CellEffect",
            "Synergy",
            "Status",
            "AiProfile",
            "Map",
            "Scenario",
            "MoveCategory",
            "MapTemplate",
            "Layer",
            "Element",
            "RulesPreset",
            "Asset",
            "Vfx",
            "Formation",
            "Origin",
            "GroupPreset",
            "ScalingProfile",
            "GameRules",
            "SquadPreset",
            "ZonePreset",
            "ModifierSet",
            "DifficultyVariant",
            "ObjectPreset"
          ]
        },
        "displayName": {
          "type": "string"
        },
        "object": {
          "$ref": "#/$defs/ScenarioObjectDef",
          "description": "Объект — Компоненты и их настройки; положение и ID задаются при установке"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": true
    },
    "ObjectStateDef": {
      "type": "object",
      "properties": {
        "color": {
          "type": "string",
          "pattern": "^(#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?)?$",
          "description": "Цвет"
        },
        "displayName": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "description": "ID — open, closed, broken…"
        },
        "model": {
          "type": "string",
          "x-ref": "Asset",
          "description": "Модель — Пусто — модель объекта"
        },
        "name": {
          "type": "string",
          "description": "Название"
        },
        "onEnter": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TriggerActionDef"
          },
          "description": "При входе в состояние — Действия сценария (общая шина событий)"
        },
        "terrain": {
          "type": "string",
          "x-ref": "Terrain",
          "description": "Местность гексов объекта — Пусто — местность карты"
        },
        "turretActive": {
          "type": "boolean",
          "description": "Турель работает — Для объекта с турелью"
        }
      },
      "additionalProperties": true
    },
    "ObjectStatesDef": {
      "type": "object",
      "properties": {
        "first": {
          "type": "string"
        },
        "initial": {
          "type": "string",
          "description": "Начальное — ID; пусто — первое"
        },
        "onDestroyed": {
          "type": "string",
          "description": "После разрушения — ID состояния, когда здоровье объекта кончилось; пусто — не меняется"
        },
        "states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectStateDef"
          },
          "description": "Состояния"
        },
        "whenOccupied": {
          "type": "string",
          "enum": [
            "Defer",
            "Evacuate",
            "Fall",
            "Forbid"
          ],
          "description": "Если на гексах юниты"
        }
      },
      "additionalProperties": true
    },
    "ReflectionDef": {
      "type": "object",
      "properties": {
        "affectsPeriodic": {
          "type": "boolean",
          "description": "Отражает периодический урон"
        },
        "base": {
          "type": "string",
          "enum": [
            "HealthLost",
            "BeforeShields"
          ],
          "description": "Считать от"
        },
        "fixedType": {
          "type": "string",
          "x-ref": "DamageType",
          "description": "Заданный тип"
        },
        "match": {
          "type": "string",
          "description": "К чему"
        },
        "meleeOnly": {
          "type": "boolean",
          "description": "Только ближний бой — Отражать только удары с соседней клетки"
        },
        "percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 500,
          "description": "Отражение, %"
        },
        "type": {
          "type": "string",
          "enum": [
            "Original",
            "Converted",
            "Fixed"
          ],
          "description": "Тип отражённого урона"
        }
      },
      "additionalProperties": true
    },
    "ScenarioObjectDef": {
      "type": "object",
      "properties": {
        "anchor": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Положение"
        },
        "color": {
          "type": "string",
          "pattern": "^(#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?)?$",
          "description": "Цвет"
        },
        "description": {
          "type": "string",
          "description": "Описание"
        },
        "displayName": {
          "type": "string"
        },
        "facing": {
          "type": "string",
          "enum": [
            "E",
            "NE",
            "NW",
            "W",
            "SW",
            "SE"
          ],
          "description": "Ориентация"
        },
        "faction": {
          "type": "string",
          "x-ref": "Faction",
          "description": "Команда"
        },
        "footprint": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 2,
            "maxItems": 2,
            "description": "[q, r]"
          },
          "description": "Занимаемые гексы — Смещения от положения при ориентации «восток»; положение входит всегда"
        },
        "health": {
          "anyOf": [
            {
              "$ref": "#/$defs/StructureDef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Здоровье и защита — Компонент: объект становится сооружением, его можно атаковать"
        },
        "id": {
          "type": "string",
          "description": "ID — Стабильный; не меняется при переименовании и перемещении"
        },
        "interaction": {
          "anyOf": [
            {
              "$ref": "#/$defs/InteractionDef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Взаимодействие — Компонент: кто, дистанция, ОД, длительность, что делает"
        },
        "marker": {
          "type": "string",
          "description": "Метка карты — Связь с маркером карты (для старых сценариев)"
        },
        "model": {
          "type": "string",
          "x-ref": "Asset",
          "description": "Модель"
        },
        "name": {
          "type": "string",
          "description": "Название"
        },
        "spawn": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpawnComponentDef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Спавн — Компонент: из объекта появляются юниты"
        },
        "states": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectStatesDef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Состояния — Компонент: открыто / закрыто / сломано; у состояния — местность гексов, вид, действия"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Теги"
        },
        "turret": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurretDef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Турель — Компонент: навык по целям (через автоатаки); без «Здоровья» — неразрушимая"
        },
        "type": {
          "type": "string",
          "enum": [
            "PlayerBase",
            "SpawnBase",
            "RoutePoint",
            "Checkpoint",
            "Defense",
            "Goal",
            "Interaction",
            "BehaviorZone",
            "Custom"
          ],
          "description": "Тип"
        }
      },
      "additionalProperties": true
    },
    "ShieldSpecDef": {
      "type": "object",
      "properties": {
        "color": {
          "type": "string",
          "pattern": "^(#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?)?$",
          "description": "Цвет"
        },
        "ignoresPeriodic": {
          "type": "boolean",
          "description": "Пропускает периодический урон"
        },
        "name": {
          "type": "string",
          "description": "Название щита"
        },
        "priority": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100,
          "description": "Приоритет расхода — Сначала расходуются щиты с большим приоритетом"
        },
        "protects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Защищает от — Пусто — от любого урона"
        },
        "regenDelay": {
          "type": "number",
          "minimum": 0,
          "maximum": 3600,
          "description": "Задержка восстановления, с — После получения урона"
        },
        "regenPerSecond": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000,
          "description": "Восстановление/с — 0 — не восстанавливается"
        },
        "stacking": {
          "type": "string",
          "enum": [
            "Refresh",
            "Add",
            "Separate",
            "ReplaceIfStronger"
          ],
          "description": "Повторное наложение"
        }
      },
      "additionalProperties": true
    },
    "SkillEffectDef": {
      "type": "object",
      "properties": {
        "aiProfile": {
